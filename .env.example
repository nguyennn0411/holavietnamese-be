# =============================================================================
# HOLA VIETNAMESE - ENVIRONMENT CONFIGURATION
# Copy this file to .env. Never commit .env or real credentials.
# One KEY=value per line; do not add trailing backslashes or escape "://".
# =============================================================================

# 1. BACKEND DATABASE
# Local: keep these values. TiDB: replace only these three variables.
DB_URL=jdbc:mysql://127.0.0.1:3307/hola_vietnamese?connectionTimeZone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=hola
DB_PASSWORD=change-me-local-app-password

FLYWAY_ENABLED=true
# Use true for a newly created empty DB. Review Flyway history before enabling
# this on an old database that already contains migrations.
FLYWAY_VALIDATE_ON_MIGRATE=true

# 2. LOCAL MYSQL DOCKER
# These create local MySQL and do not configure TiDB.
# MYSQL_PASSWORD must equal DB_PASSWORD while using local MySQL.
MYSQL_DATABASE=hola_vietnamese
MYSQL_USER=hola
MYSQL_PASSWORD=change-me-local-app-password
MYSQL_ROOT_PASSWORD=change-me-different-root-password
MYSQL_PORT=3307

# 3. APPLICATION
BACKEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-bytes
APP_ACCOUNT_SEED_ENABLED=true

# 4. GOOGLE LOGIN
GOOGLE_CLIENT_ID=

# 5. EMAIL (optional)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# 6. CLOUDINARY (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AVATAR_FOLDER=hola-vietnamese/avatars
CLOUDINARY_AUDIO_FOLDER=hola-vietnamese/audio
CLOUDINARY_COURSE_COVER_FOLDER=hola-vietnamese/courses/covers
CLOUDINARY_LESSON_IMAGE_FOLDER=hola-vietnamese/lessons/images
CLOUDINARY_LESSON_VIDEO_FOLDER=hola-vietnamese/lessons/videos
CLOUDINARY_QUESTION_IMAGE_FOLDER=hola-vietnamese/questions/images
CLOUDINARY_QUESTION_AUDIO_FOLDER=hola-vietnamese/questions/audio

# 7. AI PROVIDER (optional)
# OpenRouter example: OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_DEFAULT_MODEL=openrouter/free
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
